  "levelDecision": [
    "¿Alguien lo usa para operar algo? → 1",
    "¿Lo firma, archiva o imprime un colegio? → 2",
    "¿Lo ve alguien que todavía no es cliente? → 3",
    "¿Tiene nombre propio y fecha de inicio y fin? → 4",
    "Si queda entre dos, el más bajo"
  ],
  "color": {
    "brand": {
      "primary": "{color.brand.primary}",
      "primaryStrong": "{color.brand.primary-strong}",
      "onPrimary": "{color.brand.on-primary}",
      "night": "{color.brand.night}",
      "onNight": "{color.brand.on-night}",
      "primaryOnNight": "{color.dark.primary}",
      "accent": "{color.brand.accent}",
      "accentText": "{color.gold.700}",
      "accentSoft": "{color.gold.100}",
      "accentOnNight": "{color.brand.accent-on-night}"
    },
    "surface": {
      "page": "{color.surface.page}",
      "raised": "{color.surface.raised}",
      "sunken": "{color.surface.sunken}",
      "border": "{color.border.default}"
    },
    "text": {
      "primary": "{color.text.primary}",
      "secondary": "{color.text.secondary}",
      "muted": "{color.text.muted}"
    },
    "status": {
      "success": "{color.status.success}",
      "successText": "{color.status.success-text}",
      "successSoft": "{color.emerald.050}",
      "warning": "{color.status.warning}",
      "warningText": "{color.status.warning-text}",
      "warningSoft": "{color.amber.050}",
      "error": "{color.status.error}",
      "errorText": "{color.status.error-text}",
      "errorSoft": "{color.red.050}",
      "info": "{color.status.info}",
      "infoSoft": "{color.teal.050}"
    },
    "chart": [
      "{color.chart.light.1}",
      "{color.chart.light.2}",
      "{color.chart.light.3}",
      "{color.chart.light.4}",
      "{color.chart.light.5}"
    ],
    "chartDark": [
      "{color.chart.dark.1}",
      "{color.chart.dark.2}",
      "{color.chart.dark.3}",
      "{color.chart.dark.4}",
      "{color.chart.dark.5}"
    ],
    "exceptions": {
      "gragiNeon": {
        "value": "{color.gragi.neon}",
        "rule": "solo dentro del render del robot; nunca texto, fondo, botón ni gráfico"
      },
      "gragiBody": {
        "value": "{color.gragi.body}",
        "rule": "idem"
      },
      "aiGradient": {
        "from": "{color.ai.from}",
        "to": "{color.ai.to}",
        "rule": "único degradado permitido y solo en producto (nivel 1) para marcar acciones de IA"
      },
      "schoolColor": {
        "rule": "el color del colegio se usa tal cual lo eligió (L 18–48 %, S ≥ 45 %); nunca se lo corrige hacia el verde. Declararlo en brief.schoolColor para que el lint lo acepte."
      }
    },
    "legacyNeverUse": [
      "#227C57",
      "#1E7652",
      "#2D7830",
      "#2F7932",
      "#306D29",
      "#2E6B33",
      "#15803D",
      "#1A73E8",
      "#2FA866",
      "#1B8B50",
      "#0B6336"
    ],
    "neutralsAllowedExtra": [
      "#000000",
      "#FFFFFF"
    ],
    "pairs": {
      "allowed": [
        {
          "fg": "{color.text.primary}",
          "bg": "{color.surface.page}",
          "min": 4.5
        },
        {
          "fg": "{color.text.secondary}",
          "bg": "{color.surface.page}",
          "min": 4.5
        },
        {
          "fg": "{color.text.muted}",
          "bg": "{color.surface.raised}",
          "min": 4.5
        },
        {
          "fg": "{color.brand.primary}",
          "bg": "{color.surface.page}",
          "min": 4.5
        },
        {
          "fg": "{color.brand.on-primary}",
          "bg": "{color.brand.primary}",
          "min": 4.5
        },
        {
          "fg": "{color.brand.on-night}",
          "bg": "{color.brand.night}",
          "min": 4.5
        },
        {
          "fg": "{color.brand.accent-on-night}",
          "bg": "{color.brand.night}",
          "min": 4.5
        },
        {
          "fg": "{color.dark.primary}",
          "bg": "{color.brand.night}",
          "min": 4.5
        },
        {
          "fg": "{color.gold.700}",
          "bg": "{color.surface.page}",
          "min": 4.5
        }
      ],
      "forbidden": [
        {
          "fg": "{color.brand.primary}",
          "bg": "{color.brand.night}",
          "use": "{color.dark.primary}"
        },
        {
          "fg": "{color.brand.accent}",
          "bg": "{color.surface.page}",
          "use": "{color.gold.700}",
          "note": "el dorado 500 sobre claro solo decorativo"
        },
        {
          "fg": "{color.gragi.neon}",
          "bg": "{color.surface.page}",
          "use": null
        },
        {
          "fg": "{color.status.warning}",
          "bg": "{color.surface.raised}",
          "use": "{color.status.warning-text}"
        }
      ],
      "note": "lista no exhaustiva: cualquier texto necesita ≥ 4,5:1 contra su fondo (≥ 3:1 si mide ≥ 24px o es bold ≥ 19px). Los prohibidos están prohibidos aunque el tamaño alcance."
    },
    "combinationRules": [
      "Verde y dorado nunca adyacentes en el mismo bloque ni en series de gráfico contiguas",
      "Máximo un acento dorado por pieza",
      "Verde + rojo solo como semáforo de datos",
      "Azul no es color de Gragica: solo aparece si es del colegio o de materias en capturas del producto",
      "Sobre el color del colegio, el logo de Gragica va en blanco o en una banda papel; nunca verde"
    ],
    "toleranceRgb": 3
  },
