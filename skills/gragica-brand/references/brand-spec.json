    "roles": {
      "display": {
        "family": "serif",
        "weight": 600,
        "lineHeight": 1.04,
        "tracking": "-0.025em",
        "case": "sentence",
        "endsWith": ".",
        "use": "el remate / titular principal"
      },
      "heading": {
        "family": "serif",
        "weight": 600,
        "lineHeight": 1.08,
        "tracking": "-0.02em",
        "case": "sentence",
        "use": "título de sección o slide"
      },
      "lead": {
        "family": "sans",
        "weight": 400,
        "lineHeight": 1.45,
        "tracking": "0",
        "maxCh": 56,
        "color": "{color.text.secondary}",
        "use": "bajada"
      },
      "body": {
        "family": "sans",
        "weight": 400,
        "lineHeight": 1.5,
        "tracking": "-0.005em",
        "maxCh": 66,
        "use": "texto corrido"
      },
      "eyebrow": {
        "family": "sans",
        "weight": 500,
        "lineHeight": 1.2,
        "tracking": "0.14em",
        "case": "uppercase",
        "color": "{color.brand.primary}",
        "maxWords": 4,
        "use": "rótulo sobre el titular"
      },
      "label": {
        "family": "sans",
        "weight": 500,
        "lineHeight": 1.35,
        "tracking": "0",
        "use": "rótulos, metadatos"
      },
      "caption": {
        "family": "sans",
        "weight": 400,
        "lineHeight": 1.45,
        "tracking": "0",
        "color": "{color.text.muted}",
        "use": "pie de captura, fuente de un dato"
      },
      "figure": {
        "family": "serif",
        "weight": 600,
        "lineHeight": 1.0,
        "tracking": "-0.03em",
        "numeric": "tabular-nums lining-nums",
        "use": "cifra protagonista"
      },
      "cta": {
        "family": "sans",
        "weight": 600,
        "lineHeight": 1.1,
        "tracking": "0",
        "use": "botón o llamado"
      },
      "numeral": {
        "family": "serif",
        "weight": 600,
        "lineHeight": 1.0,
        "tracking": "0",
        "numeric": "lining-nums",
        "use": "numeración de secciones o ítems (1. 2. 3.), índice de slides"
      }
    },
    "serifForbiddenIn": [
      "button",
      "input",
      "select",
      "textarea",
      "table",
      "th",
      "td",
      "nav",
      "label"
    ],
    "remate": {
      "rule": "El titular termina con punto. La última palabra o la última línea va en {color.brand.primary} (en fondo oscuro, {color.dark.primary}). Solo una zona en verde por titular.",
      "markup": "<h1 class=\"display\">La gestión de tu colegio, <em class=\"remate\">entera.</em></h1>",
      "cssClass": "remate"
    },
    "productScaleRem": {
      "display": 1.75,
      "title": 1.5,
      "heading": 1.125,
      "subheading": 1,
      "body": 0.9375,
      "label": 0.8125,
      "caption": 0.75
    },
    "webMarketingClamp": {
      "hero": "clamp(2.5rem, 1.2rem + 5.6vw, 5rem)",
      "section": "clamp(2rem, 1.35rem + 2.8vw, 3.25rem)",
      "lead": "clamp(1.0625rem, 1rem + 0.4vw, 1.25rem)",
      "eyebrow": "12px",
      "caption": "13px"
    }
  },
